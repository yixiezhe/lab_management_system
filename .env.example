# Development template. Copy to .env; fill secrets yourself. Never commit .env.
# Generate separate random values; FERNET_KEY must be a valid Fernet key.
DJANGO_SECRET_KEY=
FERNET_KEY=
# True is for this loopback-only runserver demo, not production.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGIN_ALLOW_ALL=False
MYSQL_DB=lab_management_demo
MYSQL_USER=root
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=
# Match MYSQL_ROOT_PASSWORD for this development-only root database user.
MYSQL_PASSWORD=

# Optional assistant: requires your own compatible provider and credentials.
LABOPS_AGENT_ENABLED=False
LABOPS_AGENT_USE_LANGGRAPH=True
LABOPS_LLM_BASE_URL=
LABOPS_LLM_API_KEY=
LABOPS_LLM_MODEL=
LABOPS_LLM_TIMEOUT=45
LABOPS_LLM_MAX_TOOL_ROUNDS=2

# Optional RAG: start the rag Compose profile before enabling.
LABOPS_RAG_ENABLED=False
LABOPS_QDRANT_URL=http://qdrant:6333
LABOPS_QDRANT_COLLECTION=labops_knowledge_v1
LABOPS_OLLAMA_URL=http://ollama:11434
LABOPS_EMBEDDING_MODEL=bge-m3
LABOPS_RAG_VECTOR_SIZE=1024
LABOPS_RAG_DENSE_TOP_K=20
LABOPS_RAG_LEXICAL_TOP_K=20
LABOPS_RAG_FINAL_TOP_K=4
LABOPS_RAG_MIN_SCORE=0.20
LABOPS_RAG_TIMEOUT_SECONDS=20
LABOPS_RAG_MAX_CONTEXT_CHARS=3000

# Optional remote desktop; see deploy/guacamole/README.md.
GUACAMOLE_URL=http://localhost:8080/guacamole
GUACAMOLE_INTERNAL_API_URL=http://guacamole:8080/guacamole/api
GUAC_ADMIN_USER=guacadmin
GUAC_ADMIN_PASSWORD=
